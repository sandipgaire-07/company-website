# Supabase Environment Variables
# Copy this file to .env.local and fill in your project credentials.
# Get these from: https://supabase.com/dashboard → your project → Project Settings → API

# Project URL (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key (safe to expose in the browser — protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (NEVER expose in the browser — bypasses RLS)
# Used only in server-side code via src/lib/supabase/admin.ts
SUPABASE_SERVICE_ROLE_KEY=
